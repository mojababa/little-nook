# Copy to .env.local and adjust if your Postgres differs from compose.yaml.

# Database used by the app (`pnpm dev`, `pnpm start`) and `pnpm db:*` scripts.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/little_nook

# Database used by integration tests (`pnpm test`). Migrations are applied automatically.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/little_nook_test

# Signs sessions and email links. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# The app's public origin. On Vercel previews it defaults to the deployment URL.
BETTER_AUTH_URL=http://localhost:3000

# Transactional email (Resend). Without RESEND_API_KEY, emails are printed to
# the server log instead (or written to EMAIL_OUTBOX_DIR as JSON files, which
# is what the E2E tests use). Production must set both.
# RESEND_API_KEY=
# EMAIL_FROM=Little Nook <hello@example.com>
# EMAIL_OUTBOX_DIR=

# "Continue with Google" (sign up, log in, link in settings). Off unless both
# are set. See README → Google sign-in for setting up the OAuth client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
